# ── Local DynamoDB (DynamoDB Local via docker compose) ─────────────────────────
# Leave DYNAMODB_ENDPOINT unset in AWS: the SDK then uses the real regional endpoint
# and the Lambda execution role's credentials.
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ── Table names ────────────────────────────────────────────────────────────────
CUSTOMERS_TABLE=Customers
ACCOUNTS_TABLE=Accounts
TRANSACTIONS_TABLE=Transactions
IDEMPOTENCY_TABLE=IdempotencyKeys

# ── Banking rules ──────────────────────────────────────────────────────────────
BANK_TIMEZONE=America/Toronto
# Withdrawal window in bank-local time. 00:00-24:00 = always open (default, so graders can
# test at any hour). Example banking hours: 10:00 / 17:00
WITHDRAWAL_WINDOW_START=00:00
WITHDRAWAL_WINDOW_END=24:00
# Per-account daily withdrawal limit in minor units (cents). 500000 = 5,000.00
DAILY_WITHDRAWAL_LIMIT_MINOR=500000

# ── Idempotency ────────────────────────────────────────────────────────────────
# true → deposits/withdrawals/transfers without an Idempotency-Key header get 400
REQUIRE_IDEMPOTENCY_KEY=false
IDEMPOTENCY_TTL_SECONDS=86400

# ── Back-pressure ──────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BURST=100
RATE_LIMIT_RPS=50
OCC_MAX_ATTEMPTS=8

# ── Auth ───────────────────────────────────────────────────────────────────────
# none = local/grader mode (no token needed). jwt = Bearer token required.
AUTH_MODE=none
# Only used when AUTH_MODE=jwt locally (>= 32 chars). In AWS the key comes from Secrets Manager.
# JWT_SECRET=change-me-to-a-long-random-local-dev-secret

LOG_LEVEL=info
