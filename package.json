{
  "name": "nodejs-api-db-assessment",
  "version": "1.0.0",
  "description": "EY assessment: banking REST API on API Gateway → Lambda → DynamoDB (serverless-offline locally, AWS CDK for deployment)",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "offline": "serverless offline start --httpPort 3000",
    "start:debug": "LOG_LEVEL=debug node --inspect node_modules/serverless/bin/serverless.js offline start --httpPort 3000 --useInProcess --reloadHandler",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:create": "node scripts/create-tables.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "npm run db:create && npm run db:seed",
    "setup": "npm run db:up && node scripts/wait-for-dynamodb.js && npm run db:reset",
    "start": "npm run offline",
    "token": "node scripts/generate-token.js",
    "lint": "eslint .",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:coverage": "jest --coverage",
    "test:postman": "npx -y newman@6 run postman/Banking-API-Full.postman_collection.json"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.758.0",
    "@aws-sdk/client-secrets-manager": "^3.1167.0",
    "@aws-sdk/client-sqs": "^3.1167.0",
    "@aws-sdk/lib-dynamodb": "^3.758.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "joi": "^17.13.9",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "serverless": "^3.40.0",
    "serverless-offline": "^13.9.0"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/unit/**/*.test.js"
        ],
        "setupFiles": [
          "<rootDir>/tests/setup/env.js"
        ]
      },
      {
        "displayName": "integration",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/integration/**/*.test.js"
        ],
        "setupFiles": [
          "<rootDir>/tests/setup/env.js"
        ],
        "globalSetup": "<rootDir>/tests/setup/globalSetup.js"
      }
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/handlers/docs.js"
    ]
  }
}
