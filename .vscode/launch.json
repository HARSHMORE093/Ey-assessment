{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API (serverless-offline)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/serverless/bin/serverless.js",
      "args": ["offline", "start", "--httpPort", "3000", "--useInProcess", "--reloadHandler"],
      "env": { "LOG_LEVEL": "debug" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Debug current Jest test file",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
      "args": ["--runInBand", "--no-coverage", "${relativeFile}"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
